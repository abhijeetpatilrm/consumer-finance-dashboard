# Backend Environment Variables — copy to .env and fill in values

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://finance_user:finance_pass@localhost:5432/finance_db

# Sync DSN used by Alembic (uses psycopg2)
SYNC_DATABASE_URL=postgresql+psycopg2://finance_user:finance_pass@localhost:5432/finance_db

# App settings
APP_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
